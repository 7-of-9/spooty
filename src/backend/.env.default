DB_PATH=../../data/spooty.sqlite
FE_PATH=../frontend/browser
DOWNLOADS_PATH=./downloads
STATIC_PLAYLISTS_PATH=
FORMAT=mp3
QUALITY=0
PORT=3000
BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_RUN=false

# NOTE: DOWNLOAD_CONCURRENCY, DOWNLOAD_GAP_MS and SEARCH_CONCURRENCY are
# deliberately not set here. They are read at module-import time, before this
# file is loaded, so setting them here would have no effect. Export them as real
# environment variables instead.
#
# YouTube cookies are supplied as a Netscape-format file at /spooty/cookies.txt
# (or the equivalent path for a source install), not as an environment variable.
# Never commit that file. See the README.
# Default selected web transport is the retained, measured CLI profile.
# Persisted yt-pace.json always wins over defaults; no automatic handback/reset.
# Export YT_WEB_PROFILE=custom explicitly to use hand-tuned environment values.
# After CLI stops normally: pause/drain both web queues, then explicitly POST
# /api/youtube/profile/cli-proven before a separately authorized queue resume.
# This endpoint refuses an active owner, active work, cooldown or safety floor.
YT_WEB_PROFILE=cli-proven
YT_POT_RECOVERY_ENABLED=true
YT_POT_PLUGIN_DIR=../../data/yt-dlp-plugins
YT_POT_PROVIDER_URL=http://127.0.0.1:4416
YT_POT_HEALTH_TIMEOUT_MS=1500
YT_JS_RUNTIME_PATH=
